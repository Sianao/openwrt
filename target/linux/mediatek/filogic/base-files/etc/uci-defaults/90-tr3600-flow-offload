#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

[ "$(board_name)" = "cudy,tr3600-v1" ] || exit 0

# Offload forwarded/NAT'd flows to the MediaTek PPE (mtk_ppe_offload) through
# the nftables flowtable "flags offload" path. This is the mainline equivalent
# of the vendor SDK hardware NAT (HNAT); kmod-nft-offload is already part of
# the default router package set.
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='1'
uci -q commit firewall

exit 0
