+		.wed_rev_id		= 0,
 		.tx_bm_tkid		= 0x088,
 		.wpdma_rx_ring = {
 			0x770,
@@ -74,6 +75,7 @@
 
 static const struct mtk_wed_soc_data mt7986_data = {
 	.regmap = {
+		.wed_rev_id		= 0x4,
 		.tx_bm_tkid		= 0x0c8,
 		.wpdma_rx_ring = {
 			0x770,
@@ -89,6 +91,7 @@
 
 static const struct mtk_wed_soc_data mt7988_data = {
