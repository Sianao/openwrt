-			mtk_wed_wdma_rx_ring_setup(dev, i, 16, false);
 
 	if (dev->wlan.hw_rro) {
 		for (i = 0; i < MTK_WED_RX_PAGE_QUEUES; i++) {
@@ -2712,6 +2727,7 @@
